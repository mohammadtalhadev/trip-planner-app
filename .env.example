# TripPlanner Environment Variables Example
# Copy this file to .env or .env.local and add your actual API keys

# Geoapify API Key (for city geocoding & autocomplete)
# Get a free key at: https://myprojects.geoapify.com/
VITE_GEOAPIFY_KEY=your_geoapify_key_here

# OpenTripMap API Key (for attractions & places of interest)
# Get a free key at: https://opentripmap.io/product
VITE_OPENTRIPMAP_KEY=your_opentripmap_key_here

# Pexels API Key (for destination & travel photos)
# Get a free key at: https://www.pexels.com/api/
VITE_PEXELS_KEY=your_pexels_key_here

# NOTE:
# Open-Meteo Weather API: No API key needed (Public access)
# Wikipedia REST API: No API key needed (Public access)
# REST Countries API: No API key needed (Public access)
